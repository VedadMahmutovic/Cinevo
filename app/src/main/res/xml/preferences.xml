<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/pref_cat_appearance"
        app:iconSpaceReserved="false">
        <ListPreference
            android:defaultValue="system"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:icon="@drawable/ic_palette"
            android:key="pref_theme"
            android:title="@string/pref_theme_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_recommendations"
        app:iconSpaceReserved="false">
        <SeekBarPreference
            android:defaultValue="6"
            android:icon="@drawable/ic_tune"
            android:key="pref_min_rating"
            android:max="9"
            android:summary="@string/pref_min_rating_summary"
            android:title="@string/pref_min_rating_title"
            app:min="0"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:defaultValue="100"
            android:icon="@drawable/ic_tune"
            android:key="pref_min_votes"
            android:max="1000"
            android:summary="@string/pref_min_votes_summary"
            android:title="@string/pref_min_votes_title"
            app:min="0"
            app:seekBarIncrement="50"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_data"
        app:iconSpaceReserved="false">
        <Preference
            android:icon="@drawable/ic_delete"
            android:key="pref_clear_saved"
            android:summary="@string/pref_clear_summary"
            android:title="@string/pref_clear_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_content"
        app:iconSpaceReserved="false">
        <ListPreference
            android:defaultValue="BA"
            android:entries="@array/region_entries"
            android:entryValues="@array/region_values"
            android:icon="@drawable/ic_public"
            android:key="pref_watch_region"
            android:title="@string/pref_region_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_other"
        app:iconSpaceReserved="false">
        <Preference
            android:icon="@drawable/ic_info"
            android:key="pref_about"
            android:title="@string/pref_about_title" />
    </PreferenceCategory>

</PreferenceScreen>